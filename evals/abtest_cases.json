          "替代 proposal\\.md"
        ]
      },
      "without_skill": {
        "expected": "更可能只建议写进文档，不会稳定区分 source-notes/transcript。",
        "must_exclude": [
          "source-notes\\.md",
          "transcript\\.md"
        ]
      }
    },
    {
