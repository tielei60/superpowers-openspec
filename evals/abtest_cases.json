        "forbidden_commands": [
          "/opsx:explore",
          "/opsx:propose"
        ],
        "forbidden_artifacts": [
          "proposal.md",
          "design.md",
          "tasks.md"
        ],
        "must_include": [
          "普通修复|普通任务|直接处理|交还上层"
        ],
        "must_exclude": [
          "/opsx:explore",
          "/opsx:propose",
          "proposal\\.md",
          "design\\.md",
          "tasks\\.md"
        ]
      },
      "without_skill": {
        "expected": "普通修复建议即可。",
        "forbidden_commands": [
          "/opsx:explore",
          "/opsx:propose"
        ],
        "must_exclude": [
          "/opsx:explore",
          "/opsx:propose"
        ]
      }
    },
    {
      "id": "q5",
      "eval_id": 5,
      "tags": [
        "原始输入类",
        "补充记录类"
      ],
      "prompt": "先按 OpenSpec 规范推进，并把我原始需求和这段对话过程也记录下来。",
      "with_skill": {
        "expected": "应继续进入 OpenSpec 规范流程，并说明可选增加 source-notes.md 或 transcript.md。",
        "not_expected": "不应把原始输入记录描述为官方强制 artifact。",
