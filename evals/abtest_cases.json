{
  "version": 1,
  "description": "Local A/B benchmark cases for comparing outputs with and without superpowers-openspec.",
  "cases": [
    {
      "id": "q1",
      "eval_id": 1,
      "tags": [
        "触发类",
        "核心路由"
      ],
      "prompt": "我要做一个审批模块，先别写代码，先帮我进入 OpenSpec 规范阶段。",
      "with_skill": {
        "expected": "应触发 superpowers-openspec，并优先给出当前最合适的 /opsx:* 命令、对应产物与阶段门禁。",
        "not_expected": "不应直接进入实现；不应输出旧的 docs/specs 结构。",
        "required_commands": [
          "/opsx:propose"
        ],
        "required_artifacts": [
          "proposal.md"
        ],
        "required_mentions": [
          "规范阶段|不应直接进入实现|不进入实现"
        ],
        "forbidden_mentions": [
          "docs/specs/<feature>/openspec\\.md"
        ],
        "must_include": [
          "/opsx:propose",
          "openspec/changes/",
          "proposal\\.md",
          "规范阶段|不应直接进入实现|不进入实现"
        ],
        "must_exclude": [
          "docs/specs/<feature>/openspec\\.md"
        ]
      },
      "without_skill": {
        "expected": "更可能直接给功能分析或设计建议，而不会稳定路由到 OpenSpec / OPSX。",
        "forbidden_commands": [
          "/opsx:propose"
        ],
        "forbidden_mentions": [
          "openspec/changes/"
        ],
        "must_exclude": [
          "/opsx:propose",
          "openspec/changes/"
        ]
      }
    },
    {
      "id": "q2",
      "eval_id": 2,
      "tags": [
        "命令映射类",
        "探索类"
      ],
      "prompt": "这里是一段零散会议纪要，你先帮我整理，再决定如何进入规范。",
      "with_skill": {
        "expected": "应优先映射到 /opsx:explore，并说明后续收敛后再进入规划。",
        "not_expected": "不应跳过探索阶段直接进入实现或直接固定到 /opsx:propose。",
        "required_commands": [
          "/opsx:explore"
        ],
        "required_mentions": [
          "/opsx:propose|/opsx:new",
          "待确认|问题空间|收敛"
        ],
        "forbidden_mentions": [
          "直接开始编码"
        ],
        "must_include": [
          "/opsx:explore",
          "/opsx:propose|/opsx:new",
          "待确认|问题空间|收敛"
        ],
        "must_exclude": [
          "直接开始编码"
        ]
      },
      "without_skill": {
        "expected": "更可能直接整理需求摘要，不会稳定映射到 /opsx:explore。",
        "forbidden_commands": [
          "/opsx:explore"
        ],
        "forbidden_mentions": [
          "openspec/changes/"
        ],
        "must_exclude": [
          "/opsx:explore",
          "openspec/changes/"
        ]
      }
    },
    {
      "id": "q3",
      "eval_id": 3,
      "tags": [
        "命令映射类",
        "直接规划类"
      ],
      "prompt": "这个需求已经很完整了，直接告诉我该怎么按 OpenSpec 做。",
      "with_skill": {
        "expected": "应优先映射到 /opsx:propose，并明确使用 openspec/specs 与 openspec/changes 语义。",
        "not_expected": "不应把完整需求错误路由到 explore。",
        "required_commands": [
          "/opsx:propose"
        ],
        "required_artifacts": [
          "proposal.md"
        ],
        "required_mentions": [
          "openspec/changes/",
          "中文"
        ],
        "forbidden_commands": [
          "/opsx:explore"
        ],
        "forbidden_mentions": [
          "docs/specs/<feature>/openspec\\.md"
        ],
        "must_include": [
          "/opsx:propose",
          "openspec/changes/",
          "proposal\\.md",
          "中文"
        ],
        "must_exclude": [
          "/opsx:explore",
          "docs/specs/<feature>/openspec\\.md"
        ]
      },
      "without_skill": {
        "expected": "更可能给出通用建议，不会稳定映射到 /opsx:propose。",
        "forbidden_commands": [
          "/opsx:propose"
        ],
        "forbidden_mentions": [
          "openspec/changes/"
        ],
        "must_exclude": [
          "/opsx:propose",
          "openspec/changes/"
        ]
      }
    },
    {
      "id": "q4",
      "eval_id": 4,
      "tags": [
        "误触发类",
        "普通修复类"
      ],
      "prompt": "这里只是一个纯 bug 修复，不涉及规则、流程、接口或状态变化。",
      "with_skill": {
        "expected": "不应强制进入 superpowers-openspec；应按普通修复任务处理。",
        "not_expected": "不应把普通 bug 修复升级到 OpenSpec 规范阶段。",
        "required_mentions": [
          "普通修复|普通任务|直接处理|交还上层"
